# Copy this file to .env and fill in your own values for local dev.
# In production (Render), these are set as environment variables in the
# platform dashboard instead — never committed there either.

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Local dev Postgres. In production this is injected automatically by
# Render's managed Postgres addon (see render.yaml).
DATABASE_URL=postgresql:///email_triage_dev

# Fernet key(s) for encrypting stored Gmail refresh tokens, comma-separated
# (first = active encryption key; any listed key can still decrypt, for
# rotation). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Google Cloud OAuth client (type: Web application) — see SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/oauth/callback
